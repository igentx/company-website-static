      {
        "_uid": "contact-faq-block-001",
        "component": "faq",
        "faq_title": "Contact Questions",
        "faq_description": "Quick answers about reaching our team, response times, and how to get started with IGENTX.",
        "initial_visible_count": 10,
        "faqs": [
          {
            "_uid": "contact-faq-001",
            "component": "faq_item",
            "question": "How quickly will you respond?",
            "answer": "We aim to respond within 24 hours on business days. WhatsApp enquiries often receive a faster reply. For urgent projects, mention your timeline in your message and we will prioritise accordingly.",
            "category": "Contact"
          },
          {
            "_uid": "contact-faq-002",
            "component": "faq_item",
            "question": "What should I include in my message?",
            "answer": "A brief overview of your business, what you want to achieve, your timeline, and any budget range you have in mind. The more context you share, the more tailored our proposal will be. Links to your current website or references you admire are also helpful.",
            "category": "Contact"
          },
          {
            "_uid": "contact-faq-003",
            "component": "faq_item",
            "question": "Do you work with UAE and international clients?",
            "answer": "Yes. The UAE is our primary market, but we deliver projects globally. We support bilingual English and Arabic websites, local SEO for the UAE, and international payment and hosting setups. Distance is not a barrier to a smooth delivery process.",
            "category": "Contact"
          },
          {
            "_uid": "contact-faq-004",
            "component": "faq_item",
            "question": "Is the consultation really free?",
            "answer": "Yes. The initial consultation is free with no obligation. We will discuss your goals, suggest a practical approach, and share a tailored proposal if there is a good fit. There is no pressure to proceed.",
            "category": "Contact"
          },
          {
            "_uid": "contact-faq-005",
            "component": "faq_item",
            "question": "Can I reach you on WhatsApp?",
            "answer": "Yes. WhatsApp is our fastest channel for quick questions and initial enquiries. Use the WhatsApp card on this page to start a conversation. For detailed proposals or document sharing, email works well too.",
            "category": "Contact"
          }
        ]
      }
