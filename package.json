{
  "name": "igentx-static",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:fresh": "NEXT_PUBLIC_ENVIRONMENT=development next dev",
    "dev:https": "next dev --experimental-https",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "build:clean": "rm -rf .next && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "export:storyblok": "node scripts/export-storyblok.mjs",
    "migrate:assets": "node scripts/migrate-storyblok-assets.mjs",
    "seed:content": "node scripts/seed-new-content.mjs",
    "generate:pages": "node scripts/generate-static-pages.mjs",
    "prepare": "husky",
    "check": "npm run type-check && npm run lint",
    "precommit": "lint-staged"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@microsoft/clarity": "^1.0.0",
    "@next/third-parties": "^16.0.1",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.552.0",
    "motion": "^12.23.24",
    "next": "15.5.9",
    "node-mailjet": "^6.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.62.0",
    "simplex-noise": "^4.0.3",
    "storyblok-rich-text-react-renderer": "^2.9.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@types/node": "^20.17.6",
    "@types/node-mailjet": "^3.3.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "postcss": "^8.5.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}