# Site (required in production for canonical URLs, sitemap, and RSS)
# Use the www primary domain; apex igentx.com redirects to www with 308
NEXT_PUBLIC_SITE_URL=https://www.igentx.com
NEXT_PUBLIC_ENVIRONMENT=production

# Contact form (Mailjet)
MAILJET_API_KEY=your_api_key
MAILJET_SECRET_KEY=your_secret_key
MAILJET_FROM_EMAIL=contact_form@igentx.com
MAILJET_TO_EMAIL=hello@igentx.com

# Cloudflare Turnstile (invisible bot protection on the contact form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Theme
NEXT_PUBLIC_THEME=default
